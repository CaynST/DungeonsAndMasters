# Copy to `.env` (never commit secrets). All values are optional; the app works
# with the Mock provider when no key is present.
#
# The backend loads this file automatically via spring-dotenv, so you can start
# it with a plain `mvn spring-boot:run`.

# --- AI Dungeon Master ---
# mock | opencode-go | opencode-zen | openai-compatible
AI_PROVIDER=opencode-go
# Your OpenCode Go / Zen API key (https://opencode.ai/auth)
AI_API_KEY=
# Primary model. Cheap + 1M-token class context, well suited to a narrator.
AI_MODEL=mimo-v2.6-flash
# Tried in order when the primary fails (rate limit, region, privacy setting).
# Free models first, then Muse Spark (requires enabling "trains on request data"
# in your workspace privacy settings and a supported region).
AI_FALLBACK_MODELS=longcat-2.5-preview-free,space-bunny-free
AI_USER_AGENT=dungeons-and-masters/1.0

# Base URL: leave empty to use the provider defaults.
# OpenCode Go:  https://opencode.ai/zen/go/v1
# OpenCode Zen: https://opencode.ai/zen/v1
AI_BASE_URL=

# --- Images ---
IMAGE_PROVIDER=placeholder

# --- Security ---
# CHANGE THIS in any non-local environment.
JWT_SECRET=dev-only-secret-change-me-please-0123456789
